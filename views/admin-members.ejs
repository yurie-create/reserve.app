<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>会員一覧 | 管理画面</title>
  <link rel="stylesheet" href="/css/admin-members.css">
</head>
<body>
  <main class="page">
    <a href="/admin" class="top-link">← 管理画面トップへ戻る</a>
    <h1>会員一覧</h1>
    <% if (!members || members.length === 0) { %>
      <p class="empty">会員はまだ登録されていません。</p>
    <% } else { %>
      <ul class="member-list" aria-label="会員一覧">
        <% members.forEach(member => { %>
          <li class="member-row">
            <a href="/admin/members/<%= member.id %>" class="member-name"><%= member.name || '名前未登録' %></a>
            <a href="/admin/members/<%= member.id %>/training-logs" class="button" aria-label="<%= member.name || '名前未登録' %>の日誌">日誌</a>
            <a href="/admin/members/<%= member.id %>/records" class="button" aria-label="<%= member.name || '名前未登録' %>の記録">記録</a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>
</body>
</html>
